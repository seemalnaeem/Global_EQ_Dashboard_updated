# Copy to .env and adjust. Do not commit .env.

# Database
POSTGRES_USER=eq
POSTGRES_PASSWORD=eq
POSTGRES_DB=earthquake
DB_PORT=5438            # host port for Postgres (container stays 5432)

# Backend range 3090-3099
SERVER_PORT=3090        # Express API + WebSocket
GEO_PORT=3091           # FastAPI geoprocessing (COG conversion, vector import)
TITILER_PORT=3092       # TiTiler dynamic raster tiles

# Frontend range 5177
CLIENT_PORT=5177        # React + Vite

# Mapbox GL access token for the base map. Get one free at mapbox.com.
# Overlays and raster tiles work without it, but the base map needs it.
VITE_MAPBOX_TOKEN=

# USGS earthquake feed poller (geo service).
# Feed level: all_hour, all_day, 2.5_day, 4.5_day, significant_week, etc.
USGS_FEED=all_day
POLL_INTERVAL=60        # seconds between pollspk.eyJ1Ijoic2VlbWFsbmFlZW0iLCJhIjoiY21iNTl5bm9mMXpoajJpc2J6d3lmdWswYyJ9.iQUphkCDtGaTclzrRK3y0A

# API access. "*" is fine for LAN dev. Lock down for production.
CORS_ORIGINS=*

